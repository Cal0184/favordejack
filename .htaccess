Options -Indexes

# Archivos de soporte/backup nunca deben servirse directamente.
<FilesMatch "\.(?:sql|bak|log|ini|env|tmp|swp|orig|old|dist)$|~$">
  Require all denied
</FilesMatch>

# Archivos ocultos (.git, .env, volcados temporales «.volcado-…»). Hestia ya los
# bloquea en Nginx; esto cubre el caso de que la petición llegue a Apache.
<FilesMatch "^\.(?!well-known)">
  Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (?:^|/)\.(?!well-known/) - [F,L]
</IfModule>

# Datos internos (JSON), notas (README) y bloqueos: la web los lee desde PHP,
# el navegador nunca los necesita.
<FilesMatch "^(?!robots\.txt$).*\.(?:json|txt|md|lock)$">
  Require all denied
</FilesMatch>

# Configuración del servidor: contiene la contraseña de la base de datos.
<FilesMatch "^config\.(?:local|example)\.php$">
  Require all denied
</FilesMatch>

# El Emporio antiguo (/emporio/) quedó retirado: todo va al Emporio de Ecix's.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} ^(.*/)emporio(?:/.*)?$
  RewriteRule ^emporio(?:/.*)?$ %1tiendas/emporio/ [R=301,L]
</IfModule>

# --- Velocidad (fase 2) ---------------------------------------------------
# Compresión de texto. Las imágenes (WebP, PNG, JPG) ya vienen comprimidas.
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/javascript "access plus 1 day"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Las páginas PHP piden ?v=<fecha del archivo>: si cambia el archivo, cambia la
  # dirección, así que el navegador puede guardarlas un año sin preguntar.
  <FilesMatch "\.(?:css|js)$">
    Header set Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
    <If "%{QUERY_STRING} =~ /(^|&)v=/">
      Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
  </FilesMatch>
  <FilesMatch "\.(?:webp|png|jpe?g|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=2592000"
    <If "%{QUERY_STRING} =~ /(^|&)v=/">
      Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
  </FilesMatch>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
