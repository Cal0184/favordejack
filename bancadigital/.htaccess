Options -Indexes -MultiViews
DirectoryIndex index.php

<FilesMatch "^(config|config\.example|db|session|login|app)\.php$">
  Require all denied
</FilesMatch>

<FilesMatch "\.(sql|bak|log|ini)$">
  Require all denied
</FilesMatch>

<FilesMatch "^(CREDENCIALES|LEEME|README|NOMBRES_DE_IMAGENES).*">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^data(?:/|$) - [F,L]
  # Enlaces antiguos: vuelven a la Banca en la carpeta donde esté la web.
  RewriteCond %{REQUEST_URI} ^(.*/)[^/]+$
  RewriteRule ^(?:panel-v3|entrada-v3|salir-v3|cambiar-clave-v3)\.php$ %1 [R=302,L]
</IfModule>
